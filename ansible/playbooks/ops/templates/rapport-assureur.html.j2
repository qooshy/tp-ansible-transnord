<!doctype html>
<html lang="fr"><head><meta charset="utf-8">
<title>{{ org_name }} - état de mise à jour des serveurs</title>
<style>
 body{font:15px/1.5 system-ui,sans-serif;max-width:1000px;margin:2rem auto;padding:0 1rem;color:#1d2733}
 h1{font-size:1.5rem} table{border-collapse:collapse;width:100%} th,td{border-bottom:1px solid #dde3ea;padding:.5rem;text-align:left}
 .ok{color:#1e7d43;font-weight:600} .ko{color:#b3261e;font-weight:600} .muted{color:#5f6b7a}
</style></head><body>
<h1>{{ org_name }} — état de mise à jour et de sauvegarde des serveurs</h1>
<p class="muted">Rapport généré automatiquement le {{ now(fmt='%d/%m/%Y à %H:%M') }} par Ansible depuis {{ inventory_hostname }}.
Les mises à jour de sécurité Linux s'installent chaque nuit ; les sauvegardes sont chiffrées et stockées à Lille.</p>
{% set all_ok = rows | rejectattr('pending_sec', 'in', [0, '-']) | list | length == 0 and rows | rejectattr('backup_ok') | list | length == 0 %}
<p class="{{ 'ok' if all_ok else 'ko' }}">{{ 'Conclusion : tous les serveurs sont à jour et sauvegardés.' if all_ok else 'Conclusion : des points demandent une action (en rouge).' }}</p>
<table>
<tr><th>Serveur</th><th>Système</th><th>Mises à jour en attente (dont sécurité)</th><th>Dernière mise à jour</th><th>Dernière sauvegarde</th><th>Redémarrage requis</th></tr>
{% for r in rows | sort(attribute='host') %}
<tr>
 <td>{{ r.host }}</td><td>{{ r.os }}<br><span class="muted">{{ r.kernel }}</span></td>
 <td class="{{ 'ok' if r.pending_sec in [0, '-'] else 'ko' }}">{{ r.pending }} ({{ r.pending_sec }})</td>
 <td>{{ r.last_upgrade }}</td>
 <td class="{{ 'ok' if r.backup_ok else 'ko' }}">{{ r.last_backup }}</td>
 <td>{{ 'oui' if r.reboot else 'non' }}</td>
</tr>
{% endfor %}
</table>
</body></html>
