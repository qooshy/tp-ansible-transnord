#!/bin/bash
# Géré par Ansible. Sauvegarde chiffrée de {{ inventory_hostname }} vers {{ backup_server }}.
# Résultat publié pour la supervision (alerte si échec ou si trop ancienne).
set -uo pipefail
export BORG_REPO="{{ backup_repo }}"
export BORG_PASSCOMMAND="cat /root/.borg-passphrase"
export BORG_RSH="ssh -i /root/.ssh/id_sauvegarde -o BatchMode=yes"
export BORG_RELOCATED_REPO_ACCESS_IS_OK=yes
OUT=/var/backups/transnord
PROM=/var/lib/prometheus/node-exporter/sauvegarde.prom
STATUS=0
log() { logger -t sauvegarde "$*"; echo "$*"; }

log "Début de la sauvegarde de {{ inventory_hostname }}"

# 1. Exports cohérents des données (bases, annuaires) avant copie
{% if inventory_hostname in groups['trackr'] %}
sudo -u postgres pg_dump -Fc trackr > "$OUT/trackr.dump" || STATUS=1
{% endif %}
{% if inventory_hostname in groups['ldap_servers'] %}
slapcat -n 0 > "$OUT/ldap-config.ldif" && slapcat -n 1 > "$OUT/ldap-donnees.ldif" || STATUS=1
{% endif %}
{% if inventory_hostname in groups['domain_controllers'] %}
# Annuaire Active Directory complet (comptes, groupes, DNS, mots de passe chiffrés)
rm -rf "$OUT/ad" && mkdir -p "$OUT/ad" && samba-tool domain backup offline --targetdir="$OUT/ad" >/dev/null || STATUS=1
{% endif %}

# 2. Création du dépôt au premier passage
borg info >/dev/null 2>&1 || borg init --encryption=repokey-blake2 || STATUS=1

# 3. Copie chiffrée et dédupliquée
PATHS=()
for p in {{ (backup_paths + backup_extra_paths) | join(' ') }}; do [ -e "$p" ] && PATHS+=("$p"); done
borg create --compression zstd --exclude-caches \
  "::{{ inventory_hostname }}-{now:%Y-%m-%d_%H%M}" "${PATHS[@]}" || STATUS=1

{% if backup_local %}
# 4. Tri des anciennes sauvegardes (seul le serveur de sauvegarde peut supprimer)
borg prune {{ backup_retention }} || STATUS=1
{% endif %}

rm -rf "$OUT"/*.dump "$OUT"/*.ldif "$OUT"/ad
NOW=$(date +%s)
{
  echo "# HELP backup_last_status 0 = dernière sauvegarde réussie"
  echo "backup_last_status{host=\"{{ inventory_hostname }}\"} $STATUS"
  echo "backup_last_run_timestamp_seconds{host=\"{{ inventory_hostname }}\"} $NOW"
  if [ $STATUS -eq 0 ]; then
    echo "backup_last_success_timestamp_seconds{host=\"{{ inventory_hostname }}\"} $NOW"
  elif [ -f "$PROM" ]; then
    grep '^backup_last_success_timestamp_seconds' "$PROM"
  fi
} > "$PROM.tmp" && mv "$PROM.tmp" "$PROM"
chmod 644 "$PROM"

[ $STATUS -eq 0 ] && log "Sauvegarde réussie" || log "ÉCHEC de la sauvegarde"
exit $STATUS
