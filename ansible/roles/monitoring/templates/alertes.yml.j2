# Géré par Ansible. Chaque alerte dit en français ce qui se passe et quoi faire.
# "critique" = impact sur l'activité ; "attention" = à traiter avant que ça casse.
groups:
  - name: activite
    rules:
      - alert: TrackRIndisponible
        expr: probe_success{job="trackr_service"} == 0
        for: 30s
        labels: { severity: critique }
        annotations:
          summary: "TrackR ne répond plus"
          description: "Les postes du quai gardent les saisies en attente. Procédure : docs/RUNBOOK.md#trackr"

      - alert: TrackRServeurEnPanne
        expr: probe_success{job="trackr_noeuds"} == 0
        for: 1m
        labels: { severity: attention }
        annotations:
          summary: "Le serveur TrackR {{ '{{' }} $labels.host {{ '}}' }} ne répond plus"
          description: "TrackR continue sur l'autre serveur, mais il n'y a plus de secours. Réparer {{ '{{' }} $labels.host {{ '}}' }}."

      - alert: TrackRSansCopieDeSecours
        expr: trackr_replicas_connected == 0
        for: 2m
        labels: { severity: attention }
        annotations:
          summary: "La base TrackR n'est plus copiée sur le serveur de secours"
          description: "Après une bascule, reconstruire l'ancien serveur : docs/RUNBOOK.md#trackr-apres-une-bascule"

      - alert: LiaisonSiteCoupee
        expr: max by (site) (probe_success{job="sites", site!="{{ hostvars[inventory_hostname].site }}"}) == 0
        for: 1m
        labels: { severity: critique }
        annotations:
          summary: "Site {{ '{{' }} $labels.site {{ '}}' }} injoignable (liaison coupée ?)"
          description: "Chaque site continue de fonctionner seul (annuaire local). Contacter l'opérateur réseau."

  - name: infrastructure
    rules:
      - alert: ServeurInjoignable
        expr: up{job=~"linux|windows"} == 0
        for: 1m
        labels: { severity: critique }
        annotations:
          summary: "Le serveur {{ '{{' }} $labels.host {{ '}}' }} ne répond plus"
          description: "Site {{ '{{' }} $labels.site {{ '}}' }}."

      - alert: ControleurDeDomaineEnPanne
        expr: probe_success{job=~"ad_dns|ad_ldaps"} == 0
        for: 1m
        labels: { severity: critique }
        annotations:
          summary: "Le contrôleur de domaine {{ '{{' }} $labels.host {{ '}}' }} ne répond plus ({{ '{{' }} $labels.job {{ '}}' }})"
          description: "Les connexions basculent sur l'autre contrôleur."

      - alert: AnnuairePrestatairesEnPanne
        expr: probe_success{job="annuaire_prestataires"} == 0
        for: 1m
        labels: { severity: attention }
        annotations:
          summary: "L'annuaire des prestataires ne répond plus"
          description: "Les prestataires ne peuvent plus se connecter à TrackR."

      - alert: DisqueBientotPlein
        expr: predict_linear(node_filesystem_avail_bytes{fstype!~"tmpfs|vfat|vboxsf"}[6h], 3*24*3600) < 0
        for: 30m
        labels: { severity: attention }
        annotations:
          summary: "Le disque {{ '{{' }} $labels.mountpoint {{ '}}' }} de {{ '{{' }} $labels.host {{ '}}' }} sera plein dans moins de 3 jours"
          description: "Anticiper : faire de la place ou agrandir le disque."

      - alert: DisquePresquePlein
        expr: (1 - node_filesystem_avail_bytes{fstype!~"tmpfs|vfat|vboxsf"} / node_filesystem_size_bytes) > 0.85
        for: 10m
        labels: { severity: attention }
        annotations:
          summary: "Disque {{ '{{' }} $labels.mountpoint {{ '}}' }} de {{ '{{' }} $labels.host {{ '}}' }} rempli à plus de 85 %"
          description: ""

      - alert: CertificatBientotExpire
        expr: (probe_ssl_earliest_cert_expiry - time()) / 86400 < 30
        for: 1h
        labels: { severity: attention }
        annotations:
          summary: "Le certificat de {{ '{{' }} $labels.instance {{ '}}' }} expire dans moins de 30 jours"
          description: "Relancer le playbook site.yml : les certificats sont renouvelés automatiquement."

  - name: conformite
    rules:
      - alert: SauvegardeTropAncienne
        expr: time() - backup_last_success_timestamp_seconds > 26 * 3600
        for: 10m
        labels: { severity: critique }
        annotations:
          summary: "Pas de sauvegarde réussie depuis plus de 26 h sur {{ '{{' }} $labels.host {{ '}}' }}"
          description: "Voir /var/log/central/{{ '{{' }} $labels.host {{ '}}' }}/sauvegarde.log"

      - alert: SauvegardeEnEchec
        expr: backup_last_status != 0
        for: 5m
        labels: { severity: critique }
        annotations:
          summary: "La dernière sauvegarde de {{ '{{' }} $labels.host {{ '}}' }} a échoué"
          description: "Voir /var/log/central/{{ '{{' }} $labels.host {{ '}}' }}/sauvegarde.log"

      - alert: MisesAJourDeSecuriteEnAttente
        expr: sum by (host) (apt_upgrades_pending{origin=~".*[Ss]ecurity.*"}) > 0
        for: 2d
        labels: { severity: attention }
        annotations:
          summary: "{{ '{{' }} $labels.host {{ '}}' }} a des mises à jour de sécurité non installées depuis 2 jours"
          description: "Vérifier /var/log/unattended-upgrades/ sur le serveur."

      - alert: RedemarrageNecessaire
        expr: node_reboot_required > 0
        for: 7d
        labels: { severity: attention }
        annotations:
          summary: "{{ '{{' }} $labels.host {{ '}}' }} attend un redémarrage depuis 7 jours (mise à jour du noyau)"
          description: "Planifier un redémarrage le dimanche (pas d'activité)."
