# Géré par Ansible - la liste des cibles vient de l'inventaire : un nouveau
# serveur est surveillé automatiquement dès qu'il est ajouté.
global:
  scrape_interval: 15s
  evaluation_interval: 15s

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['localhost:9093']

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: linux
    static_configs:
{% for h in groups['linux'] %}
      - targets: ['{{ hostvars[h].ansible_host }}:9100']
        labels: { host: {{ h }}, site: {{ hostvars[h].site }} }
{% endfor %}

{% if groups['windows'] | default([]) %}
  - job_name: windows
    static_configs:
{% for h in groups['windows'] %}
      - targets: ['{{ hostvars[h].ansible_host }}:9182']
        labels: { host: {{ h }}, site: {{ hostvars[h].site }} }
{% endfor %}
{% endif %}

  - job_name: trackr_app
    scheme: https
    tls_config:
      ca_file: {{ ca_file }}
    static_configs:
{% for h in groups['trackr'] %}
      - targets: ['{{ h }}.{{ domain_fqdn }}']
        labels: { host: {{ h }}, site: {{ hostvars[h].site }} }
{% endfor %}

{% macro blackbox(job, module, targets) %}
  - job_name: {{ job }}
    metrics_path: /probe
    params:
      module: [{{ module }}]
    static_configs:
{% for t in targets %}
      - targets: ['{{ t.target }}']
        labels: { host: {{ t.host }}, site: {{ t.site }} }
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: localhost:9115
{% endmacro %}
{{ blackbox('trackr_service', 'http_2xx', [{'target': 'https://' ~ trackr_fqdn ~ '/health', 'host': 'trackr', 'site': 'dunkerque'}]) }}
{%- set nodes = [] %}{% for h in groups['trackr'] %}{% set _ = nodes.append({'target': 'https://' ~ h ~ '.' ~ domain_fqdn ~ '/health', 'host': h, 'site': hostvars[h].site}) %}{% endfor %}
{{ blackbox('trackr_noeuds', 'http_2xx', nodes) }}
{%- set l = [] %}{% for h in groups['ldap_servers'] %}{% set _ = l.append({'target': h ~ '.' ~ domain_fqdn ~ ':636', 'host': h, 'site': hostvars[h].site}) %}{% endfor %}
{{ blackbox('annuaire_prestataires', 'tcp_tls', l) }}
{%- set d = [] %}{% for h in groups['domain_controllers'] %}{% set _ = d.append({'target': hostvars[h].ansible_host ~ ':53', 'host': h, 'site': hostvars[h].site}) %}{% endfor %}
{{ blackbox('ad_dns', 'dns_ad', d) }}
{%- set a = [] %}{% for h in groups['domain_controllers'] %}{% set _ = a.append({'target': h ~ '.' ~ domain_fqdn ~ ':636', 'host': h, 'site': hostvars[h].site}) %}{% endfor %}
{{ blackbox('ad_ldaps', 'tcp_tls', a) }}
{%- set p = [] %}{% for h in groups['all'] %}{% set _ = p.append({'target': hostvars[h].ansible_host, 'host': h, 'site': hostvars[h].site}) %}{% endfor %}
{{ blackbox('sites', 'icmp', p) }}
