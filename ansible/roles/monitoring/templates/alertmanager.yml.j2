# Géré par Ansible - les alertes partent par e-mail à l'équipe informatique.
global:
  smtp_smarthost: 127.0.0.1:1025
  smtp_from: supervision@{{ domain_fqdn }}
  smtp_require_tls: false

route:
  receiver: informatique
  group_by: [alertname, host]
  group_wait: 10s
  group_interval: 1m
  repeat_interval: 4h

receivers:
  - name: informatique
    email_configs:
      - to: {{ alert_email }}
        send_resolved: true
        headers:
          Subject: '[{{ '{{' }} .Status | toUpper {{ '}}' }}] {{ '{{' }} .CommonAnnotations.summary {{ '}}' }}'

inhibit_rules:
  # Si TrackR entier est en panne, inutile d'envoyer aussi "un serveur TrackR en panne"
  - source_matchers: [alertname="TrackRIndisponible"]
    target_matchers: [alertname="TrackRServeurEnPanne"]
