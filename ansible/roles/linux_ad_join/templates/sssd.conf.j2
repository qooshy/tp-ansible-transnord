# Géré par Ansible
[sssd]
domains = {{ domain_fqdn }}
config_file_version = 2
services = nss, pam

[domain/{{ domain_fqdn }}]
id_provider = ad
access_provider = simple
ad_domain = {{ domain_fqdn }}
krb5_realm = {{ domain_realm }}
realmd_tags = manages-system joined-with-adcli
# DC du site en premier : si la liaison inter-sites est coupée, on reste autonome
ad_server = {{ ntp_servers | join(', ') }}
use_fully_qualified_names = False
fallback_homedir = /home/%u
default_shell = /bin/bash
ldap_id_mapping = True
# Connexion possible même si aucun DC ne répond (identifiants mis en cache)
cache_credentials = True
krb5_store_password_if_offline = True
# Seuls les administrateurs Linux peuvent ouvrir une session
simple_allow_groups = {{ linux_admin_group | lower }}
ad_gpo_access_control = permissive
dyndns_update = False
