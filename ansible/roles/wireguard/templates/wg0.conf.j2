# Géré par Ansible - un bloc [Peer] par informaticien (liste issue du fichier RH)
[Interface]
Address = {{ vpn_server_ip }}/24
ListenPort = {{ vpn_port }}
PostUp = wg set %i private-key /etc/wireguard/serveur.key
{% for u in vpn_users %}

# {{ u.prenom }} {{ u.nom }} ({{ u.identifiant }})
[Peer]
PublicKey = {{ wg_pub['/etc/wireguard/clients/' ~ u.identifiant ~ '.key'] }}
AllowedIPs = {{ vpn_prefix }}.{{ 10 + loop.index0 }}/32
{% endfor %}
