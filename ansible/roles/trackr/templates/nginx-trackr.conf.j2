# Géré par Ansible
server {
    listen 80 default_server;
    server_name _;
    return 301 https://{{ trackr_fqdn }}$request_uri;
}

server {
    listen 443 ssl http2 default_server;
    server_name {{ trackr_fqdn }} {{ inventory_hostname }} {{ fqdn }};

    ssl_certificate     /etc/nginx/trackr.crt;
    ssl_certificate_key /etc/nginx/trackr.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self'" always;

    location /metrics {
        allow {{ hostvars[groups['monitoring'][0]].ansible_host }};
        allow 127.0.0.1;
        deny all;
        proxy_pass http://127.0.0.1:8000;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }
}
