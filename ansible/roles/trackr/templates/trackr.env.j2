TRACKR_SECRET_KEY={{ vault_trackr_secret_key }}
TRACKR_AD_SERVERS={{ ntp_servers | join(',') }}
TRACKR_AD_DOMAIN={{ domain_fqdn }}
TRACKR_AD_BASE={{ domain_dn }}
TRACKR_PRESTA_SERVER={{ ldap_fqdn }}
TRACKR_PRESTA_BASE=ou=prestataires,{{ ldap_base_dn }}
TRACKR_CA_FILE=/etc/ssl/certs/ca-certificates.crt
TRACKR_WRITER_GROUPS={{ trackr_writer_groups | join(',') }}
TRACKR_READER_GROUPS={{ trackr_reader_groups | join(',') }}
