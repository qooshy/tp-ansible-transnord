#!/bin/bash
# Géré par Ansible. Répond "oui" (code 0) si CE serveur peut porter l'adresse TrackR.
#  - l'application locale doit répondre ;
#  - un serveur de secours ne prend la main que si le principal ne répond plus.
role() { python3 -c 'import json,sys; print(json.load(sys.stdin).get("db_role",""))' 2>/dev/null; }

LOCAL=$(curl -fsk --max-time 2 https://127.0.0.1/health) || exit 1
[ "$(echo "$LOCAL" | role)" = "primary" ] && exit 0

for PEER in {% for h in groups['trackr'] if h != inventory_hostname %}{{ hostvars[h].ansible_host }} {% endfor %}; do
  P=$(curl -fsk --max-time 2 "https://$PEER/health") || continue
  [ "$(echo "$P" | role)" = "primary" ] && exit 1      # le principal est vivant : on reste en secours
done
exit 0
