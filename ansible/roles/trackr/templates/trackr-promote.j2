#!/bin/bash
# Géré par Ansible. Appelé par keepalived quand CE serveur prend l'adresse TrackR :
# si sa base est une copie, elle devient la base principale.
IN_RECOVERY=$(sudo -n -u postgres psql -tAc "SELECT pg_is_in_recovery()" 2>/dev/null)
if [ "$IN_RECOVERY" = "t" ]; then
  logger -t trackr-bascule -p daemon.crit "$(hostname) prend la main : la copie de la base devient principale"
  sudo -n -u postgres psql -tAc "SELECT pg_promote(true, 30)" >/dev/null
else
  logger -t trackr-bascule -p daemon.notice "$(hostname) porte l'adresse TrackR {{ trackr_vip }}"
fi
