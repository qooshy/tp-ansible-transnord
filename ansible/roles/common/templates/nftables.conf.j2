#!/usr/sbin/nft -f
# Géré par Ansible - tout est fermé sauf ce qui est listé ici.
flush ruleset

table inet filter {
  set admin_sources {
    type ipv4_addr; flags interval
    elements = { {{ lab_cidr }}, {{ vpn_cidr }} }
  }

  chain input {
    type filter hook input priority 0; policy drop;
    ct state established,related accept
    ct state invalid drop
    iif lo accept
    ip protocol icmp accept
    meta l4proto ipv6-icmp accept
    tcp dport 22 ip saddr @admin_sources accept
    iifname "eth0" tcp dport 22 accept comment "acces Vagrant (labo uniquement)"
    tcp dport 9100 ip saddr {{ monitoring_ip }} accept comment "supervision"
{% for r in firewall_allow %}
    {{ r.proto | default('tcp') }} dport {{ r.port }}{% if r.from | default('any') != 'any' %} ip saddr {{ r.from }}{% endif %} accept{% if r.comment is defined %} comment "{{ r.comment }}"{% endif %}

{% endfor %}
{% for r in firewall_extra_rules %}
    {{ r }}
{% endfor %}
    limit rate 5/minute log prefix "pare-feu refus: "
    drop
  }

  chain forward {
    type filter hook forward priority 0; policy drop;
{% for r in firewall_forward_rules %}
    {{ r }}
{% endfor %}
  }

  chain output {
    type filter hook output priority 0; policy accept;
  }
}
{% if firewall_nat_rules %}

table ip nat {
  chain postrouting {
    type nat hook postrouting priority 100;
{% for r in firewall_nat_rules %}
    {{ r }}
{% endfor %}
  }
}
{% endif %}
