# Géré par Ansible
{% if inventory_hostname in groups['domain_controllers'] %}
# Contrôleur de domaine : horloge de référence du réseau (signée pour les postes Windows)
{%   if inventory_hostname == pdc %}
{%     for s in ntp_upstream %}
pool {{ s }} iburst
{%     endfor %}
{%   else %}
server {{ pdc }}.{{ domain_fqdn }} iburst prefer
{%     for s in ntp_upstream %}
pool {{ s }} iburst
{%     endfor %}
{%   endif %}
allow {{ lab_cidr }}
allow {{ vpn_cidr }}
ntpsigndsocket /var/lib/samba/ntp_signd
local stratum 10
{% else %}
# L'heure vient des contrôleurs de domaine (indispensable à Kerberos :
# un écart de plus de 5 minutes bloque les connexions).
{%   for s in ntp_servers %}
server {{ s }} iburst
{%   endfor %}
{% endif %}
driftfile /var/lib/chrony/chrony.drift
makestep 1 3
rtcsync
logdir /var/log/chrony
