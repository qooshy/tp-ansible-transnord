# Géré par Ansible
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
MaxAuthTries 4
LoginGraceTime 30
X11Forwarding no
LogLevel VERBOSE
{% if inventory_hostname in groups['control'] %}
# Bastion : les informaticiens (réseau interne ou VPN) s'y connectent avec
# leur identifiant unique de l'annuaire.
Match Address {{ lab_cidr }},{{ vpn_cidr }}
    PasswordAuthentication yes
{% else %}
# Les autres serveurs n'acceptent un mot de passe que depuis le bastion ops01.
Match Address {{ hostvars[groups['control'][0]].ansible_host }}
    PasswordAuthentication yes
{% endif %}
