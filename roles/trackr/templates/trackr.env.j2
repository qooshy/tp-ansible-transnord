# {{ ansible_managed }}
# Configuration de TrackR : chaque réglage est expliqué dans le README du cours.
# TrackR n'écoute qu'en local : c'est nginx qui le publie, en HTTPS.
TRACKR_LISTEN=127.0.0.1
TRACKR_PORT=8080

# La base sur db01 (MC11)
TRACKR_DB=postgresql://trackr:{{ vault_trackr_db_password }}@{{ hostvars[groups['databases'][0]].lan_ip }}/trackr
TRACKR_DEMO={{ 'yes' if trackr_demo else 'no' }}

# Signature des sessions : la même à chaque déploiement, sinon tout le monde est déconnecté
TRACKR_SECRET={{ vault_trackr_secret }}
TRACKR_COOKIE_SECURE=yes

TRACKR_AUTH={{ trackr_auth }}
{% if trackr_auth == 'local' %}
# Labo sans Active Directory uniquement
TRACKR_LOCAL_USERS={{ vault_trackr_local_users }}
{% else %}
TRACKR_AD_DOMAIN={{ ad_domain }}
# Le DC du site d'abord ; si un DC tombe, TrackR passe tout seul au suivant
TRACKR_AD_SERVERS={{ trackr_ad_servers | join(',') }}
TRACKR_AD_GROUP={{ trackr_ad_group }}
TRACKR_AD_TLS=ldaps
TRACKR_AD_CA_FILE=/etc/trackr/ad-ca.crt
{% endif %}
TRACKR_LOG_LEVEL=INFO
