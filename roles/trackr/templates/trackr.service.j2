# {{ ansible_managed }}
# MC11 : TrackR en service robuste. Il redémarre seul après un plantage
# (y compris un kill -9) et ne peut pas abîmer le reste de la machine.
[Unit]
Description=TrackR - suivi des expéditions de LogiNord
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
User=trackr
Group=trackr
EnvironmentFile=/etc/trackr/trackr.env
ExecStart=/opt/trackr/trackr /etc/trackr/trackr.env
Restart=on-failure
RestartSec=5

# Durcissement (systemd-analyze security trackr)
ProtectSystem=strict
ReadWritePaths=/var/lib/trackr
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

# Une fuite mémoire ne fait plus tomber la machine entière
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
