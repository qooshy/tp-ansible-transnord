# {{ ansible_managed }}
# Chaque alerte : une mesure, un seuil, une durée (for), et ce qu'il faut faire.
groups:
  - name: activite
    rules:
      - alert: TrackRIndisponible
        expr: probe_success{job="trackr"} == 0
        for: 1m
        labels: { severity: critique }
        annotations:
          summary: "TrackR ne répond plus ({{ '{{' }} $labels.host {{ '}}' }})"
          description: "Les camions ne sont plus suivis. Voir docs/RUNBOOK.md, section TrackR."

      - alert: BaseTrackRInjoignable
        expr: probe_success{job="postgresql"} == 0
        for: 1m
        labels: { severity: critique }
        annotations:
          summary: "La base de TrackR (db01) ne répond plus"
          description: "TrackR ne peut plus enregistrer les expéditions."

      - alert: TunnelInterSitesCoupe
        expr: probe_success{job="tunnel"} == 0
        for: 1m
        labels: { severity: critique }
        annotations:
          summary: "Le tunnel Lille - Dunkerque est coupé"
          description: "Chaque site continue seul (DC local, cache SSSD). Vérifier le lien et 'wg show' sur les routeurs."

  - name: infrastructure
    rules:
      - alert: ServeurInjoignable
        expr: up{job=~"linux|windows"} == 0
        for: 2m
        labels: { severity: critique }
        annotations:
          summary: "{{ '{{' }} $labels.host {{ '}}' }} ne répond plus"
          description: "Site {{ '{{' }} $labels.site {{ '}}' }}."

      - alert: ControleurDeDomaineEnPanne
        expr: probe_success{job=~"ad_dns|ad_ldaps"} == 0
        for: 2m
        labels: { severity: critique }
        annotations:
          summary: "Le contrôleur de domaine {{ '{{' }} $labels.host {{ '}}' }} ne répond plus ({{ '{{' }} $labels.job {{ '}}' }})"
          description: "Les connexions passent par l'autre DC. Ne jamais redémarrer les deux en même temps."

      - alert: AnnuairePrestatairesEnPanne
        expr: probe_success{job="annuaire_prestataires"} == 0
        for: 2m
        labels: { severity: attention }
        annotations:
          summary: "L'annuaire des prestataires (ldap01) ne répond plus"
          description: "Les prestataires ne peuvent plus se connecter."

      # La règle du cours (MC15) : moins de 10 % d'espace libre depuis 5 minutes
      - alert: DisqueBientotPlein
        expr: node_filesystem_avail_bytes{job="linux",fstype!~"tmpfs|vfat|vboxsf"} / node_filesystem_size_bytes{job="linux",fstype!~"tmpfs|vfat|vboxsf"} < 0.10
        for: 5m
        labels: { severity: attention }
        annotations:
          summary: "Disque {{ '{{' }} $labels.mountpoint {{ '}}' }} de {{ '{{' }} $labels.host {{ '}}' }} : moins de 10 % libre"
          description: "Faire de la place ou agrandir le volume avant que le service s'arrête."

      - alert: DisqueSeRemplitVite
        expr: predict_linear(node_filesystem_avail_bytes{job="linux",fstype!~"tmpfs|vfat|vboxsf"}[6h], 3*24*3600) < 0
        for: 30m
        labels: { severity: attention }
        annotations:
          summary: "Le disque {{ '{{' }} $labels.mountpoint {{ '}}' }} de {{ '{{' }} $labels.host {{ '}}' }} sera plein dans moins de 3 jours"
          description: "Anticiper."

      - alert: CertificatBientotExpire
        expr: (probe_ssl_earliest_cert_expiry - time()) / 86400 < 30
        for: 1h
        labels: { severity: attention }
        annotations:
          summary: "Le certificat de {{ '{{' }} $labels.instance {{ '}}' }} expire dans moins de 30 jours"
          description: "Relancer site.yml : les certificats internes sont renouvelés."

  - name: conformite
    rules:
      # La base de TrackR est sauvegardée toutes les heures : 2 h sans sauvegarde = alerte
      - alert: SauvegardeBaseTropAncienne
        expr: time() - backup_last_success_timestamp_seconds{host=~"{{ groups['databases'] | join('|') }}"} > 2 * 3600
        for: 10m
        labels: { severity: critique }
        annotations:
          summary: "Plus de 2 h sans sauvegarde de la base TrackR ({{ '{{' }} $labels.host {{ '}}' }})"
          description: "journalctl -u sauvegarde sur le serveur."

      - alert: SauvegardeTropAncienne
        expr: time() - backup_last_success_timestamp_seconds{host!~"{{ groups['databases'] | join('|') }}"} > 26 * 3600
        for: 10m
        labels: { severity: critique }
        annotations:
          summary: "Plus de 26 h sans sauvegarde sur {{ '{{' }} $labels.host {{ '}}' }}"
          description: "journalctl -u sauvegarde sur le serveur."

      - alert: SauvegardeEnEchec
        expr: backup_last_status != 0
        for: 5m
        labels: { severity: critique }
        annotations:
          summary: "La dernière sauvegarde de {{ '{{' }} $labels.host {{ '}}' }} a échoué"
          description: "journalctl -u sauvegarde sur le serveur."

      - alert: MisesAJourDeSecuriteEnAttente
        expr: sum by (host) (apt_upgrades_pending{origin=~".*[Ss]ecurity.*"}) > 0
        for: 2d
        labels: { severity: attention }
        annotations:
          summary: "{{ '{{' }} $labels.host {{ '}}' }} a des correctifs de sécurité non installés depuis 2 jours"
          description: "Vérifier /var/log/unattended-upgrades/."

      - alert: RedemarrageEnAttente
        expr: node_reboot_required > 0
        for: 7d
        labels: { severity: attention }
        annotations:
          summary: "{{ '{{' }} $labels.host {{ '}}' }} attend un redémarrage depuis 7 jours"
          description: "Il sera fait par la campagne du dimanche (patch-linux.yml)."
