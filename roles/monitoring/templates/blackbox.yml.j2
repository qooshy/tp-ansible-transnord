# {{ ansible_managed }}
# Les sondes testent les services comme le ferait un utilisateur.
modules:
  http_2xx:
    prober: http
    timeout: 5s
    http:
      preferred_ip_protocol: ip4
      tls_config:
        ca_file: {{ ca_file }}
  tcp_connect:
    prober: tcp
    timeout: 5s
    tcp:
      preferred_ip_protocol: ip4
  tcp_tls:
    prober: tcp
    timeout: 5s
    tcp:
      preferred_ip_protocol: ip4
      tls: true
      tls_config:
        ca_file: {{ ca_file }}
  dns_ad:
    prober: dns
    timeout: 5s
    dns:
      preferred_ip_protocol: ip4
      query_name: {{ ad_domain }}
      query_type: SOA
      valid_rcodes: [NOERROR]
  icmp:
    prober: icmp
    timeout: 3s
    icmp:
      preferred_ip_protocol: ip4
